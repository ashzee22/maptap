#!/usr/bin/env python3
"""
Pulls the latest MapTap scores for Ashley, Beth, and Kaitlyn and updates
the `reportData` JSON embedded in index.html.
"""

import json
import re
import statistics
from collections import Counter, defaultdict
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

import requests

# Locate index.html regardless of working directory
SCRIPT_DIR = Path(__file__).parent
REPO_ROOT = SCRIPT_DIR.parent if SCRIPT_DIR.name == "scripts" else SCRIPT_DIR
TARGET_FILE = REPO_ROOT / "index.html"

API_URL = "https://us-central1-jjexperiment-12af6.cloudfunctions.net/getPublicProfile"

PLAYERS = {
    "Ashley": {"nickname": "ash_zee2", "color": "#d946ef"},
    "Beth": {"nickname": "MBZ", "color": "#38bdf8"},
    "Kaitlyn": {"nickname": "DaBestKaitlyn", "color": "#fb923c"},
}

EASTERN = ZoneInfo("America/New_York")
INACTIVE_AFTER_DAYS = 7
ACTIVE_WINDOW_DAYS = 5


# ---------------------------------------------------------------------------
# Fetching + parsing MapTap data
# ---------------------------------------------------------------------------

def fetch_profile(nickname: str) -> dict:
    resp = requests.post(
        API_URL,
        headers={"Content-Type": "application/json"},
        json={"data": {"nickname": nickname}},
        timeout=15,
    )
    resp.raise_for_status()
    payload = resp.json()
    return payload.get("result", payload)


def label_for(dt: datetime) -> str:
    """'2026-08-04' -> 'Aug 4' - matches the site's date format."""
    return f"{dt.strftime('%b')} {dt.day}"


def parse_label(label: str, year: int) -> datetime:
    """Inverse of label_for(), given an assumed year."""
    try:
        return datetime.strptime(f"{label} {year}", "%b %d %Y")
    except ValueError:
        return datetime.now()


def extract_history(profile: dict) -> list[dict]:
    user = profile.get("user", {}) if isinstance(profile, dict) else {}
    game_history = user.get("gameHistory", {}) or {}
    history = []

    if isinstance(game_history, list):
        games = game_history
    elif isinstance(game_history, dict):
        games = game_history.values()
    else:
        games = []

    for game in games:
        if not isinstance(game, dict):
            continue

        date_iso = game.get("date") or game.get("date_iso")
        score = game.get("finalScore")

        if score is None or not date_iso:
            continue

        try:
            dt = datetime.strptime(date_iso, "%Y-%m-%d")
        except ValueError:
            continue

        rounds = [
            r["score"]
            for r in game.get("rounds", [])
            if isinstance(r, dict) and "score" in r
        ]

        history.append({
            "date_iso": date_iso,
            "date": label_for(dt),
            "score": score,
            "rounds": rounds,
        })

    history.sort(key=lambda h: h["date_iso"])
    return history


# ---------------------------------------------------------------------------
# Stats Helpers
# ---------------------------------------------------------------------------

def linear_trend(scores: list[float]) -> float | None:
    n = len(scores)
    if n < 2:
        return None
    xs = list(range(n))
    x_mean = statistics.mean(xs)
    y_mean = statistics.mean(scores)
    num = sum((x - x_mean) * (y - y_mean) for x, y in zip(xs, scores))
    den = sum((x - x_mean) ** 2 for x in xs)
    return round(num / den, 2) if den else None


def compute_round_stats(games_with_rounds: list[dict]) -> dict:
    games = [g for g in games_with_rounds if g.get("rounds")]
    if not games:
        return {
            "hundreds": 0, "mode1": None, "mode1_count": None,
            "mode2": None, "mode2_count": None, "mode3": None, "mode3_count": None,
            "pos_avgs": [],
        }
    freq = Counter()
    position_scores = defaultdict(list)
    hundreds = 0
    for game in games:
        for i, rscore in enumerate(game["rounds"]):
            freq[rscore] += 1
            position_scores[i].append(rscore)
            if rscore == 100:
                hundreds += 1
    top3 = freq.most_common(3)
    while len(top3) < 3:
        top3.append((None, None))
    pos_avgs = [round(statistics.mean(position_scores[i]), 1) for i in sorted(position_scores)]
    return {
        "hundreds": hundreds,
        "mode1": top3[0][0], "mode1_count": top3[0][1],
        "mode2": top3[1][0], "mode2_count": top3[1][1],
        "mode3": top3[2][0], "mode3_count": top3[2][1],
        "pos_avgs": pos_avgs,
    }


def compute_person_stats(name: str, color: str, all_time_games: list[dict],
                          api_history: list[dict], today: datetime,
                          win_counts: dict, second_counts: dict, loss_counts: dict,
                          last_win_date: datetime | None) -> dict:
    if not all_time_games:
        return {
            "name": name, "color": color, "verified": True, "games": 0,
            "avg": None, "median": None, "high": None, "low": None, "low_date": None,
            "wins": 0, "seconds": 0, "losses": 0, "flags": 0, "ghost_days": 0,
            "hundreds": 0, "std": None, "days_since_last_game": None,
            "days_since_last_win": None, "recent_game_count": 0, "pos_avgs": [],
            "last5_avg": None, "form_delta": None, "mode1": None, "mode1_count": None,
            "mode2": None, "mode2_count": None, "mode3": None, "mode3_count": None,
            "nickname": "Rookie", "blurb": "No games played yet this season.",
        }

    scores = [g["score"] for g in all_time_games]
    low_game = min(all_time_games, key=lambda g: g["score"])
    last_game = all_time_games[-1]
    last_game_date = last_game.get("date_iso_dt", today)

    last5 = scores[-5:]
    last5_avg = round(statistics.mean(last5), 1) if last5 else None
    avg = round(statistics.mean(scores), 1)
    form_delta = round(last5_avg - avg, 1) if last5_avg is not None else None

    round_stats = compute_round_stats(api_history)

    days_since_last_game = (today.date() - last_game_date.date()).days
    days_since_last_win = (
        (today.date() - last_win_date.date()).days if last_win_date else None
    )

    recent_cutoff = last_game_date - timedelta(days=ACTIVE_WINDOW_DAYS)
    recent_game_count = sum(
        1 for g in all_time_games
        if g.get("date_iso_dt", today) >= recent_cutoff
    )

    stats = {
        "name": name,
        "color": color,
        "verified": True,
        "games": len(scores),
        "avg": avg,
        "median": statistics.median(scores),
        "high": max(scores),
        "low": min(scores),
        "low_date": low_game["date"],
        "wins": win_counts.get(name, 0),
        "seconds": second_counts.get(name, 0),
        "losses": loss_counts.get(name, 0),
        "flags": 0,
        "ghost_days": 0,
        "std": round(statistics.stdev(scores), 1) if len(scores) > 1 else 0.0,
        "days_since_last_game": days_since_last_game,
        "days_since_last_win": days_since_last_win,
        "recent_game_count": recent_game_count,
        "last5_avg": last5_avg,
        "form_delta": form_delta,
        **round_stats,
    }

    if form_delta is not None and form_delta > 20:
        stats["nickname"] = "On a Heater"
        stats["blurb"] = f"{name} is averaging {avg} and running hot (+{form_delta} over last 5)."
    elif form_delta is not None and form_delta < -20:
        stats["nickname"] = "Cooling Off"
        stats["blurb"] = f"{name} is averaging {avg}, but running {form_delta} over last 5."
    else:
        stats["nickname"] = "Steady"
        stats["blurb"] = f"{name} averages {avg} across {len(scores)} games (High: {max(scores)})."

    return stats


# ---------------------------------------------------------------------------
# Main Routine
# ---------------------------------------------------------------------------

def main():
    if not TARGET_FILE.exists():
        print(f"ERROR: File not found at {TARGET_FILE}")
        return

    content = TARGET_FILE.read_text(encoding="utf-8")

    # Match reportData = { ... }; pattern across multiple lines
    match = re.search(r"(const\s+reportData\s*=\s*)(\{[\s\S]*?\})(\s*;)", content)
    if not match:
        print("ERROR: Could not locate 'const reportData = {...};' in index.html!")
        return

    prefix, raw_json, suffix = match.group(1), match.group(2), match.group(3)
    try:
        data = json.loads(raw_json)
    except json.JSONDecodeError as e:
        print(f"ERROR: Failed to parse embedded reportData JSON: {e}")
        return

    now_eastern = datetime.now(EASTERN)
    today = now_eastern.replace(tzinfo=None)

    # 1. Existing raw_log (preserves legacy entries for Ashley/others not on MapTap)
    existing_by_player = defaultdict(dict)
    for entry in data.get("raw_log", []):
        existing_by_player[entry["person"]][entry["date"]] = entry

    # 2. Fetch fresh API entries
    all_games_by_player = {}
    api_history_by_player = {}
    badges_by_player = {}

    for name, info in PLAYERS.items():
        print(f"Fetching profile for {name} ({info['nickname']})...")
        try:
            profile = fetch_profile(info["nickname"])
            api_history = extract_history(profile)
            badges = (profile.get("user", {}) or {}).get("badges")
            print(f"  -> Retrieved {len(api_history)} games from API for {name}")
        except Exception as e:
            print(f"  -> WARNING: Failed to fetch {name}: {e}")
            api_history = []
            badges = None

        api_history_by_player[name] = api_history
        badges_by_player[name] = badges

        existing_dates = existing_by_player[name]
        merged = []

        # Preserve legacy/manual records
        for date_label, entry in existing_dates.items():
            if date_label not in {g["date"] for g in api_history}:
                merged.append({
                    "date": date_label,
                    "date_iso_dt": parse_label(date_label, today.year),
                    "score": entry["score"],
                    "rounds": [],
                    "_flagged": entry.get("flagged", False),
                    "_note": entry.get("note"),
                })

        # Insert fresh API entries
        for g in api_history:
            prior = existing_dates.get(g["date"])
            merged.append({
                "date": g["date"],
                "date_iso_dt": datetime.strptime(g["date_iso"], "%Y-%m-%d"),
                "score": g["score"],
                "rounds": g["rounds"],
                "_flagged": prior.get("flagged", False) if prior else False,
                "_note": prior.get("note") if prior else None,
            })

        merged.sort(key=lambda g: g["date_iso_dt"])
        all_games_by_player[name] = merged

    # 3. Rebuild global category dates
    all_dates = {g["date_iso_dt"]: g["date"] for games in all_games_by_player.values() for g in games}
    ordered_dts = sorted(all_dates.keys())
    categories = [all_dates[dt] for dt in ordered_dts]

    # 4. Win/loss counts
    scores_by_date = defaultdict(dict)
    for name, games in all_games_by_player.items():
        for g in games:
            scores_by_date[g["date"]][name] = g["score"]

    win_counts, second_counts, loss_counts = defaultdict(int), defaultdict(int), defaultdict(int)
    last_win_date = {}
    for dt in ordered_dts:
        date_label = all_dates[dt]
        day_scores = scores_by_date.get(date_label, {})
        if not day_scores:
            continue
        distinct_desc = sorted(set(day_scores.values()), reverse=True)
        top = distinct_desc[0]
        winners = [p for p, s in day_scores.items() if s == top]
        for w in winners:
            win_counts[w] += 1
            last_win_date[w] = dt
        if len(day_scores) > 1 and len(distinct_desc) > 1:
            for p, s in day_scores.items():
                if s == distinct_desc[1]:
                    second_counts[p] += 1
        if len(day_scores) > 1:
            bottom = distinct_desc[-1]
            for p, s in day_scores.items():
                if s == bottom and bottom != top:
                    loss_counts[p] += 1

    # 5. Build stats & datasets
    person_stats = []
    for name, info in PLAYERS.items():
        stats = compute_person_stats(
            name, info["color"], all_games_by_player[name],
            api_history_by_player[name], today, win_counts,
            second_counts, loss_counts, last_win_date.get(name)
        )
        person_stats.append(stats)

    series = []
    for name, info in PLAYERS.items():
        by_date = {g["date"]: g["score"] for g in all_games_by_player[name]}
        series.append({
            "name": name,
            "color": info["color"],
            "data": [by_date.get(cat) for cat in categories],
        })

    raw_log = []
    for name, games in all_games_by_player.items():
        for g in games:
            raw_log.append({
                "date": g["date"],
                "person": name,
                "score": g["score"],
                "flagged": g["_flagged"],
                "note": g["_note"],
            })
    raw_log.sort(key=lambda r: (parse_label(r["date"], today.year), r["person"]), reverse=True)

    all_scores = [r["score"] for r in raw_log]
    group_stats = {
        "total_days": len(categories),
        "total_games": len(raw_log),
        "group_avg": round(statistics.mean(all_scores), 1) if all_scores else 0,
        "date_range": f"{categories[0]} - {categories[-1]}" if categories else "",
    }

    # 6. Write updated object back to index.html
    data["categories"] = categories
    data["series"] = series
    data["person_stats"] = person_stats
    data["group_stats"] = group_stats
    data["raw_log"] = raw_log
    data["generated_at"] = now_eastern.strftime("%B %-d, %Y at %I:%M %p")

    new_content = content[:match.start()] + prefix + json.dumps(data, indent=2, ensure_ascii=False) + suffix + content[match.end():]
    TARGET_FILE.write_text(new_content, encoding="utf-8")
    print(f"Successfully updated {TARGET_FILE} with {len(raw_log)} total games!")


if __name__ == "__main__":
    main()
