#!/usr/bin/env python3
"""
Pulls MapTap scores for Ashley, Beth, and Kaitlyn.
Uses Gemini API to generate daily, creative, game-show style scouting reports and predictions.
"""

import json
import os
import re
import statistics
from collections import Counter, defaultdict
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

import requests
from google import genai

SCRIPT_DIR = Path(__file__).parent
REPO_ROOT = SCRIPT_DIR.parent if SCRIPT_DIR.name == "scripts" else SCRIPT_DIR
TARGET_FILE = REPO_ROOT / "index.html"

API_URL = "https://us-central1-jjexperiment-12af6.cloudfunctions.net/getPublicProfile"

PLAYERS = {
    "Ashley": {"nickname": "ash_zee2", "color": "#d946ef"},
    "Beth": {"nickname": "MBZ", "color": "#38bdf8"},
    "Kaitlyn": {"nickname": "DaBestKaitlyn", "color": "#fb923c"},
}

EASTERN = ZoneInfo("America/New_York")


def fetch_profile(nickname: str) -> dict:
    resp = requests.post(
        API_URL,
        headers={"Content-Type": "application/json"},
        json={"data": {"nickname": nickname}},
        timeout=15,
    )
    resp.raise_for_status()
    payload = resp.json()
    return payload.get("result", payload)


def label_for(dt: datetime) -> str:
    return f"{dt.strftime('%b')} {dt.day}"


def parse_label(label: str, year: int) -> datetime:
    try:
        return datetime.strptime(f"{label} {year}", "%b %d %Y")
    except ValueError:
        return datetime.now()


def extract_history(profile: dict) -> list[dict]:
    user = profile.get("user", {}) if isinstance(profile, dict) else {}
    game_history = user.get("gameHistory", {}) or {}
    history = []

    games = game_history if isinstance(game_history, list) else game_history.values() if isinstance(game_history, dict) else []

    for game in games:
        if not isinstance(game, dict):
            continue
        date_iso = game.get("date") or game.get("date_iso")
        score = game.get("finalScore")

        if score is None or not date_iso:
            continue

        try:
            dt = datetime.strptime(date_iso, "%Y-%m-%d")
        except ValueError:
            continue

        rounds = [r["score"] for r in game.get("rounds", []) if isinstance(r, dict) and "score" in r]
        history.append({
            "date_iso": date_iso,
            "date": label_for(dt),
            "score": score,
            "rounds": rounds,
        })

    history.sort(key=lambda h: h["date_iso"])
    return history


def generate_gemini_content(player_data_summary: list[dict]) -> dict:
    """Sends stats to Gemini API to get fresh, dramatic commentary."""
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        print("WARNING: GEMINI_API_KEY not found in environment. Skipping AI generation.")
        return {}

    client = genai.Client(api_key=api_key)

    prompt = f"""
You are an over-the-top, energetic gameshow host and esports analyst commenting on a geography map-guessing league.
Analyze the following player statistics and produce JSON output matching the schema strictly.

Player Stats Data:
{json.dumps(player_data_summary, indent=2)}

Requirements:
1. "scouting": An array of objects for EVERY player with keys:
   - "name": string
   - "nickname": Short dynamic gameshow nickname (e.g., "The Triple-Point Titan", "The Map Monarch")
   - "title": Full title with quotation marks (e.g., '"Ashley the Triple-Point Titan"')
   - "blurb": 2-3 sentence theatrical, game-show summary referencing their stats (average, high, trend, volatility).
   - "good": Single punchy sentence highlighting their top strength.
   - "bad": Single punchy sentence highlighting their main vulnerability.
2. "predictions": A markdown-formatted string starting with "🔥 **Next Week's Predictions**: " that EXPLICITLY mentions EVERY single player (Ashley, Beth, Kaitlyn) by name with commentary on their upcoming matchup.

Return ONLY raw JSON, no markdown code blocks.
"""

    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt,
        config={"response_mime_type": "application/json"}
    )

    try:
        return json.loads(response.text)
    except Exception as e:
        print(f"Failed to parse Gemini output: {e}")
        return {}


def main():
    if not TARGET_FILE.exists():
        print(f"ERROR: File not found at {TARGET_FILE}")
        return

    content = TARGET_FILE.read_text(encoding="utf-8")
    match = re.search(r"(const\s+reportData\s*=\s*)(\{[\s\S]*?\})(\s*;)", content)
    if not match:
        print("ERROR: Could not locate 'const reportData = {...};' in index.html!")
        return

    prefix, raw_json, suffix = match.group(1), match.group(2), match.group(3)
    data = json.loads(raw_json)

    now_eastern = datetime.now(EASTERN)
    today = now_eastern.replace(tzinfo=None)

    all_games_by_player = {}
    for name, info in PLAYERS.items():
        try:
            profile = fetch_profile(info["nickname"])
            all_games_by_player[name] = extract_history(profile)
        except Exception as e:
            print(f"Warning: Failed fetching {name}: {e}")
            all_games_by_player[name] = []

    all_dates = {g["date_iso"]: g["date"] for games in all_games_by_player.values() for g in games}
    categories = list(dict.fromkeys([g["date"] for games in all_games_by_player.values() for g in games]))

    scores_by_date = defaultdict(dict)
    for name, games in all_games_by_player.items():
        for g in games:
            scores_by_date[g["date"]][name] = g["score"]

    # Calculate wins
    win_counts = defaultdict(int)
    for date_label in categories:
        day_scores = scores_by_date.get(date_label, {})
        if len(day_scores) >= 2:
            top_score = max(day_scores.values())
            for p, s in day_scores.items():
                if s == top_score:
                    win_counts[p] += 1

    person_stats = []
    stats_for_ai = []

    for name, info in PLAYERS.items():
        games = all_games_by_player[name]
        scores = [g["score"] for g in games]

        avg = round(statistics.mean(scores), 1) if scores else None
        high = max(scores) if scores else None
        low = min(scores) if scores else None
        std = round(statistics.stdev(scores), 1) if len(scores) > 1 else 0.0
        last5_avg = round(statistics.mean(scores[-5:]), 1) if scores else None
        form_delta = round(last5_avg - avg, 1) if (last5_avg is not None and avg is not None) else None

        player_summary = {
            "name": name,
            "games_played": len(scores),
            "season_avg": avg,
            "high_score": high,
            "low_score": low,
            "std_dev": std,
            "recent_form_delta": form_delta,
            "wins": win_counts[name],
        }
        stats_for_ai.append(player_summary)

        person_stats.append({
            "name": name,
            "color": info["color"],
            "games": len(scores),
            "avg": avg,
            "high": high,
            "low": low,
            "wins": win_counts[name],
            "std": std,
            "form_delta": form_delta,
        })

    # Call Gemini API
    ai_results = generate_gemini_content(stats_for_ai)
    scouting_map = {item["name"]: item for item in ai_results.get("scouting", [])}

    for p in person_stats:
        scout = scouting_map.get(p["name"], {})
        p["nickname"] = scout.get("nickname", "Contender")
        p["title"] = scout.get("title", f'"{p["name"]} the Competitor"')
        p["blurb"] = scout.get("blurb", f"{p['name']} is holding down a {p['avg']} average this season.")
        p["scouting_good"] = scout.get("good", "Solid map consistency across rounds.")
        p["scouting_bad"] = scout.get("bad", "Needs to watch out for cold streaks.")

    series = [
        {"name": name, "color": info["color"], "data": [scores_by_date[cat].get(name) for cat in categories]}
        for name, info in PLAYERS.items()
    ]

    data["categories"] = categories
    data["series"] = series
    data["person_stats"] = person_stats
    data["predictions"] = ai_results.get(
        "predictions", 
        "🔥 **Next Week's Predictions**: Ashley, Beth, and Kaitlyn are all preparing for an intense week of map showdowns!"
    )
    data["generated_at"] = now_eastern.strftime("%B %-d, %Y at %I:%M %p")

    new_content = content[:match.start()] + prefix + json.dumps(data, indent=2, ensure_ascii=False) + suffix + content[match.end():]
    TARGET_FILE.write_text(new_content, encoding="utf-8")
    print("Successfully updated stats and generated AI game-show commentary!")


if __name__ == "__main__":
    main()
